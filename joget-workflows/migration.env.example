# Every value that changes between this laptop and WSO2 Cloud. Copy to migration.env (git-ignored).
# Secrets are never written here: each *_SECRET_NAME names a key in ~/vexa-system/.secrets/env.

# --- Temporal (durable workflow engine) ---
TEMPORAL_MODE="CLOUD"                                   # LOCAL here; CLOUD for Temporal Cloud or WSO2 managed Temporal
TEMPORAL_URL="CHANGE_ME_namespace.CHANGE_ME_account.tmprl.cloud:7233"   # given by WSO2 with the managed Temporal (~10 Nov, unverified)
TEMPORAL_NAMESPACE="CHANGE_ME_namespace.CHANGE_ME_account"
TEMPORAL_API_KEY_SECRET_NAME="TEMPORAL_CLOUD_API_KEY"
TEMPORAL_TASK_QUEUE="JOGET_WORKFLOWS_TASK_QUEUE"

# --- WSO2 workflow Management API (what Joget calls) ---
MGMT_PORT="8234"
MGMT_API_KEY_SECRET_NAME="WSO2_WORKFLOW_MGMT_API_KEY"
MGMT_PUBLIC_URL="https://CHANGE_ME_hosted_runtime/workflow"      # goes into the Joget API Connector base URL

# --- Joget (what the workflows call) ---
JOGET_BASE_URL="https://jogetwso2.on.joget.cloud/jw/api"   # API Builder base; locally http://localhost:8096/jw/api
JOGET_API_ID_SECRET_NAME="JOGET_MUF_API_ID"     # MUF API; secrets file ~/vexa-system/.secrets/wso2-joget-api.env
JOGET_API_KEY_SECRET_NAME="JOGET_MUF_API_KEY"
# One key pair per app (same secrets file): JOGET_<APP>_API_ID / JOGET_<APP>_API_KEY
JOGET_APP_KEY_PREFIXES="WSO2DESK WSO2HRLEAVE WSO2LOAN WSO2ONBOARDING BIZONBOARDING"
MUF_RULES_PATH="/list/list_muf_rule_api?pageSize=500"
MUF_RECORD_PATH="/form/muf_wso2_case_view/{id}"
MUF_STATUS_PATH="/form/muf_wso2_writeback/saveOrUpdate"

# --- Mail ---
SMTP_HOST="CHANGE_ME_smtp_relay"
SMTP_PORT="587"
SMTP_USER="CHANGE_ME_user"
SMTP_PASSWORD_SECRET_NAME="WORKFLOW_SMTP_PASSWORD"
SMTP_STARTTLS="true"
